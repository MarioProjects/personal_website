---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { LINKS } from "../lib/constants";
import Github from "./icons/Github.astro";
import Linkedin from "./icons/Linkedin.astro";
import Aidventure from "./icons/Aidventure.astro";
import Kaggle from "./icons/Kaggle.astro";
import HuggingFace from "./icons/HuggingFace.astro";
import { Image } from "astro:assets";
---

<Card colSpan="md:col-span-2 xl:col-span-3" rowSpan="xl:row-span-4">
  <div class="flex h-full w-full flex-col gap-5 md:flex-row md:gap-8">
    <div class="flex flex-1 flex-col justify-between gap-6">
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between gap-4">
          <span class="text-xs font-medium uppercase tracking-[0.2em] text-muted">welcome</span>
          <!-- Compact avatar on phones; the full portrait lives on the right from md up -->
          <Image
            width="112"
            height="112"
            src="/me.webp"
            class="h-14 w-14 shrink-0 rounded-full object-cover object-top select-none md:hidden"
            alt="Portrait of Mario Parreño"
            loading="eager"
          />
        </div>
        <p class="m-0 text-lg font-light leading-relaxed sm:text-xl">
          Hi, I'm <b class="font-bold">Mario Parreño</b>, a Senior Machine Learning Engineer specializing in
          <b class="font-bold">Agentic AI</b>, <b class="font-bold">RAG</b>, and
          <b class="font-bold">Computer Vision</b>. I focus on designing scalable AI architectures and
          autonomous systems that solve complex, real-world problems with precision and efficiency.
        </p>
      </div>
      <nav aria-label="Profiles and links" class="flex flex-wrap gap-3">
        <Button href={LINKS.github} label="GitHub profile">
          <Github class="h-6 w-6" aria-hidden="true" />
        </Button>
        <Button href={LINKS.linkedin} label="LinkedIn profile">
          <Linkedin class="h-6 w-6" aria-hidden="true" />
        </Button>
        <Button href={LINKS.aidventure} label="AIdventure blog">
          <Aidventure class="h-6 w-6" aria-hidden="true" />
        </Button>
        <Button href={LINKS.kaggle} label="Kaggle profile">
          <Kaggle class="h-5 w-5" aria-hidden="true" />
        </Button>
        <Button href={LINKS.huggingface} label="Hugging Face profile" class="hover:text-[#FFD21E]">
          <HuggingFace class="h-6 w-6" aria-hidden="true" />
        </Button>
      </nav>
    </div>
    <Image
      width="300"
      height="300"
      src="/me.webp"
      class="hidden md:block md:self-center h-auto w-auto max-h-[300px] rounded-lg select-none pointer-events-none"
      alt="Mario Parreño at the beach with his dog"
      loading="eager"
    />
  </div>
</Card>
