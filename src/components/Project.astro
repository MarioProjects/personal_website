---
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  description?: string;
  url?: string;
}

const { title, description, url } = Astro.props;
---

<div
  class="card group relative w-full overflow-hidden rounded-xl border border-darkslate-100 bg-darkslate-500 shadow-lg transition-all duration-200 ease-out hover:border-primary-500 hover:-translate-y-0.5 focus-within:border-primary-500"
>
  <a href={url} target="_blank" rel="noopener noreferrer" class="flex h-full w-full flex-col p-5 sm:p-6">
    <Icon
      name="ri:arrow-right-up-line"
      class="absolute top-5 right-5 sm:top-6 sm:right-6 h-6 text-muted group-hover:text-primary-500 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all ease-in-out duration-200 z-20"
      aria-hidden="true"
    />
    <h2 class="pr-8 text-xl font-semibold sm:text-2xl">
      {title}
    </h2>
    <p class="mt-1 text-sm leading-relaxed text-muted sm:text-base">
      {description}
    </p>
  </a>
</div>
