---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  class="fixed top-3 right-3 sm:top-4 sm:right-4 z-60 flex h-10 w-10 items-center justify-center rounded-full border border-darkslate-100 bg-darkslate-500 shadow-md transition-colors duration-200 hover:border-primary-500 hover:text-primary-500"
  type="button"
  title="Toggle light / dark theme"
  aria-label="Toggle light / dark theme"
>
  <Icon size={20} name="mdi:white-balance-sunny" id="light-on" aria-hidden="true" />
  <Icon size={20} name="mdi:moon-and-stars" id="light-off" aria-hidden="true" />
</button>

<style is:global>
  /* Icon visibility is driven purely by the theme attribute set in <head>. */
  :root[data-theme="dark"] #light-on {
    display: none;
  }
  :root:not([data-theme="dark"]) #light-off {
    display: none;
  }
</style>

<script>
  declare global {
    interface Window {
      togglePreference: () => void;
    }
  }
  document
    .getElementById("theme-toggle")
    ?.addEventListener("click", () => window.togglePreference());
</script>
