---
import Card from "./Card/index.astro";

const stats = [
  { value: "8+", label: "Years experience" },
  { value: "10+", label: "Certificates" },
];
---

<Card colSpan="md:col-span-2" rowSpan="xl:row-span-2" title="My Stats">
  <div class="mt-3 flex h-full w-full flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-relaxed sm:max-w-[55%]">
      Top Kaggle Expert and published researcher. I turn complex challenges into practical,
      high-impact AI solutions.
    </p>
    <dl class="flex gap-8 sm:justify-end">
      {
        stats.map((stat) => (
          <div class="flex flex-col">
            <dd class="m-0 text-3xl font-bold leading-none tabular-nums">
              {stat.value.replace("+", "")}<span class="text-primary-500">+</span>
            </dd>
            <dt class="mt-1 text-xs uppercase tracking-wide text-muted">{stat.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</Card>
