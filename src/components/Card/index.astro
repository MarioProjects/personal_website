---
import { Icon } from "astro-icon/components";
import Content from "./Content.astro";

interface Props {
  title?: string;
  body?: string;
  /** Column span utilities, e.g. "md:col-span-2 xl:col-span-3" */
  colSpan?: string;
  /** Row span utilities, only meaningful on the xl bento grid, e.g. "xl:row-span-4" */
  rowSpan?: string;
  /** Internal link: the whole card becomes a link with an arrow affordance */
  href?: string;
  /** External document (PDF): the whole card becomes a link opening in a new tab */
  document?: string;
  colorText?: string;
  padding?: string;
}

const { title, body, colSpan, rowSpan, href, colorText, padding, document } = Astro.props;

const interactive = Boolean(href || document);

const classes = [
  "card group relative z-10 flex flex-col w-full h-full overflow-hidden",
  "bg-darkslate-500 border border-darkslate-100 rounded-xl shadow-lg",
  padding || "p-5 sm:p-6",
  "transition-colors duration-200 ease-out",
  interactive ? "hover:border-primary-500 focus-within:border-primary-500" : "",
  colSpan || "md:col-span-1",
  rowSpan || "",
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  {
    href ? (
      <a href={href} class={`flex flex-col h-full w-full ${colorText || ""}`}>
        <Icon
          name="ri:arrow-right-up-line"
          class="absolute top-5 right-5 sm:top-6 sm:right-6 text-xl h-6 text-muted group-hover:text-primary-500 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all ease-in-out duration-200 z-20"
          aria-hidden="true"
        />
        <Content title={title} body={body} titleClass="pr-8">
          <slot />
        </Content>
      </a>
    ) : document ? (
      <a
        href={document}
        class={`flex flex-col h-full w-full ${colorText || ""}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon
          name="mdi:document"
          class="absolute top-5 right-5 sm:top-6 sm:right-6 text-xl h-6 text-muted group-hover:text-primary-500 transition-colors duration-200 z-20"
          aria-hidden="true"
        />
        <Content title={title} body={body} titleClass="pr-8">
          <slot />
        </Content>
      </a>
    ) : (
      <Content title={title} body={body}>
        <slot />
      </Content>
    )
  }
</div>
