---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import Stats from "../components/Stats.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
---

<script>
  import { stagger, spring, timeline, type TimelineDefinition } from "motion";
  import { loaderAnimation } from "../lib/constants";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cards = document.querySelectorAll(".card");

  const sequence: TimelineDefinition = reduceMotion
    ? [loaderAnimation as any]
    : [
        loaderAnimation as any,
        [
          cards,
          { y: ["40%", "0%"], opacity: [0, 1] },
          {
            at: "-0.1",
            duration: 0.4,
            delay: stagger(0.1),
            easing: spring({ velocity: 100, stiffness: 50, damping: 10 }),
          },
        ],
      ];

  timeline(sequence);
</script>

<Layout
  title="Mario Parreño - Machine Learning Engineer"
  description="Senior Machine Learning Engineer specializing in Agentic AI, RAG and Computer Vision. I design scalable AI architectures and autonomous systems that solve real-world problems."
>
  <!--
    Layout by breakpoint:
    - base: single column, cards stack.
    - md:   two columns (tablets, small laptops), rows size to content, dense packing so no gaps are left.
    - xl:   the 4x8 bento grid. Rows size to content (never clip) and stretch to fill
            the minimum height when there is room, so the board still fills the screen.
    The top padding below xl reserves a band for the fixed theme toggle.
  -->
  <main
    class="relative m-auto w-full max-w-6xl grid grid-cols-1 gap-3 p-3 pt-16 sm:gap-4 sm:p-4 sm:pt-16 md:grid-cols-2 md:grid-flow-row-dense md:p-6 md:pt-16 xl:grid-cols-4 xl:grid-rows-[repeat(8,auto)] xl:min-h-[min(88vh,900px)] xl:pt-6"
  >
    <IntroCard />
    <AboutMe />
    <ContactsCard />
    <Stats />
    <Now />
    <Card
      colSpan="md:col-span-1"
      rowSpan="xl:row-span-1"
      title="Personal Projects"
      body="Code, write-ups and live demos."
      href="/projects"
    />
    <Card
      colSpan="md:col-span-1"
      rowSpan="xl:row-span-2"
      title="CV"
      document="/mario_resume.pdf"
      body="Want the full picture? Click anywhere on this card to open my resume as a PDF. Do not hesitate to contact me if you have any questions."
    />
    <TimeZone />
  </main>
</Layout>
